# ─── Daily.Deals environment variables (set in Netlify → Site settings → Environment) ───
# Everything is optional: the site runs and refreshes itself with none of these set.

# Site
NEXT_PUBLIC_SITE_URL=https://daily.deals

# Automation
CRON_SECRET=                      # shared secret for /api/* cron endpoints (also signs /go links)
ANTHROPIC_API_KEY=                # optional: Claude curator + Daily Edition morning note (rule-based fallback otherwise)
SUPABASE_PAT=                     # Supabase personal access token — lets migrations auto-apply on cold start

# Monetization
NEXT_PUBLIC_AMAZON_US_TAG=dailydeal0dbc-20
NEXT_PUBLIC_AMAZON_CA_TAG=        # Amazon.ca Associates tag (falls back to the US tag)
NEXT_PUBLIC_SKIMLINKS_ID=302790X1790814
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=   # optional manual ad units — Auto ads work without these
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Forms → inbox (server-side only; the destination address is never sent to the browser)
CONTACT_EMAIL=                    # override the default inbox
RESEND_API_KEY=                   # preferred delivery provider (optional)
RESEND_FROM=                      # e.g. "Daily.Deals <alerts@daily.deals>" once the domain is verified in Resend
WEB3FORMS_ACCESS_KEY=             # alternative provider (optional)
FORMSUBMIT_ALIAS=                 # FormSubmit hashed alias, shown after the one-time activation email

# Donations (/support) — first configured option wins; PayPal by inbox address is the default
STRIPE_DONATION_LINK=             # Stripe Payment Link (customer chooses amount)
STRIPE_MONTHLY_LINK=              # Stripe Payment Link for monthly support
PAYPAL_HOSTED_BUTTON_ID=          # PayPal Donate hosted button
PAYPAL_RECEIVER=                  # override the PayPal receiver account

# Giveaway
NEXT_PUBLIC_CONTEST_PRIZE=
NEXT_PUBLIC_CONTEST_PRIZE_VALUE=
